  "segments": [
    {
      "startSeconds": 0.06,
      "endSeconds": 3.201,
      "text": "نُحت هذا الجعران الضخم من\nحجر الديوريت."
    },
    {
      "startSeconds": 4.022,
      "endSeconds": 8.964,
      "text": "ويرجح أنه يمثل خبري، أحد\nأشكال إله الشمس المرتبطة"
    },
    {
      "startSeconds": 9.124,
      "endSeconds": 9.924,
      "text": "بشروقها."
    },
    {
      "startSeconds": 10.764,
      "endSeconds": 15.426,
      "text": "في معتقدات مصر القديمة، كان\nالجعران يرمز إلى الولادة"
    },
    {
      "startSeconds": 15.566,
      "endSeconds": 16.387,
      "text": "والتجدد."
    },
    {
      "startSeconds": 17.047,
      "endSeconds": 22.289,
      "text": "تأمل جسمه المستدير وأرجله\nوالقاعدة التي يستند إليها."
    },
    {
      "startSeconds": 23.17,
      "endSeconds": 27.171,
      "text": "لقد حوّل النحات حشرة صغيرة\nإلى حضور ضخم."
    },
    {
      "startSeconds": 27.872,
      "endSeconds": 33.054,
      "text": "تدعونا هذه القطعة إلى اكتشاف\nالصلة بين عالم الطبيعة وصور"
    },
    {
      "startSeconds": 33.054,
      "endSeconds": 33.834,
      "text": "الآلهة."
    }
  ],
