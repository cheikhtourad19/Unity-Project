  "segments": [
    {
      "startSeconds": 0.08,
      "endSeconds": 1.84,
      "text": "A stone scarab"
    },
    {
      "startSeconds": 2.76,
      "endSeconds": 6.361,
      "text": "rests on a rectangular base."
    },
    {
      "startSeconds": 7.861,
      "endSeconds": 8.681,
      "text": "Its body"
    },
    {
      "startSeconds": 9.461,
      "endSeconds": 12.101,
      "text": "is broad and rounded,"
    },
    {
      "startSeconds": 13.282,
      "endSeconds": 15.142,
      "text": "with a domed back."
    },
    {
      "startSeconds": 16.302,
      "endSeconds": 17.102,
      "text": "The head"
    },
    {
      "startSeconds": 17.742,
      "endSeconds": 20.262,
      "text": "occupies one end."
    },
    {
      "startSeconds": 21.403,
      "endSeconds": 26.283,
      "text": "Its legs are carved along\nthe"
    },
    {
      "startSeconds": 26.423,
      "endSeconds": 27.423,
      "text": "sides,"
    },
    {
      "startSeconds": 28.303,
      "endSeconds": 30.684,
      "text": "close to the base."
    },
    {
      "startSeconds": 32.444,
      "endSeconds": 36.264,
      "text": "The overall form is compact:"
    },
    {
      "startSeconds": 37.725,
      "endSeconds": 39.345,
      "text": "the body’s mass"
    },
    {
      "startSeconds": 39.985,
      "endSeconds": 44.905,
      "text": "dominates the finer details\nof the"
    },
    {
      "startSeconds": 45.066,
      "endSeconds": 46.226,
      "text": "insect."
    }
  ],
