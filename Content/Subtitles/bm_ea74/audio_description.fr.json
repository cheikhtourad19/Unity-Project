  "segments": [
    {
      "startSeconds": 0.06,
      "endSeconds": 2.721,
      "text": "Un scarabée de pierre repose\nsur une base rectangulaire."
    },
    {
      "startSeconds": 3.161,
      "endSeconds": 6.582,
      "text": "Son corps est large et\narrondi, avec un dos bombé."
    },
    {
      "startSeconds": 7.042,
      "endSeconds": 9.403,
      "text": "La tête occupe l’une des\nextrémités."
    },
    {
      "startSeconds": 9.663,
      "endSeconds": 12.464,
      "text": "Les pattes sont sculptées\nsur les côtés, près de la"
    },
    {
      "startSeconds": 12.464,
      "endSeconds": 16.845,
      "text": "base. L’ensemble est compact\n: la masse du corps domine"
    },
    {
      "startSeconds": 17.005,
      "endSeconds": 19.066,
      "text": "les détails plus fins de\nl’insecte."
    }
  ],
