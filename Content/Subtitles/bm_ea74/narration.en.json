  "segments": [
    {
      "startSeconds": 0.06,
      "endSeconds": 3.342,
      "text": "This monumental scarab is\ncarved from diorite."
    },
    {
      "startSeconds": 4.123,
      "endSeconds": 6.144,
      "text": "It probably represents\nKhepri,"
    },
    {
      "startSeconds": 7.025,
      "endSeconds": 9.826,
      "text": "a form of the sun god\nassociated with sunrise."
    },
    {
      "startSeconds": 10.807,
      "endSeconds": 14.61,
      "text": "In ancient Egyptian beliefs,\nthe scarab evoked birth and"
    },
    {
      "startSeconds": 14.61,
      "endSeconds": 15.41,
      "text": "renewal."
    },
    {
      "startSeconds": 16.031,
      "endSeconds": 17.211,
      "text": "Notice its rounded body,"
    },
    {
      "startSeconds": 17.832,
      "endSeconds": 19.833,
      "text": "its legs and the base\nbeneath it."
    },
    {
      "startSeconds": 20.734,
      "endSeconds": 24.476,
      "text": "The sculptor transformed a\nsmall insect into a"
    },
    {
      "startSeconds": 24.536,
      "endSeconds": 26.518,
      "text": "monumental presence."
    },
    {
      "startSeconds": 28.019,
      "endSeconds": 32.782,
      "text": "This work invites us to\nexplore the connection between"
    },
    {
      "startSeconds": 32.782,
      "endSeconds": 36.785,
      "text": "the natural world and images\nof the gods."
    }
  ],
