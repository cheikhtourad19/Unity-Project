  "segments": [
    {
      "startSeconds": 0.08,
      "endSeconds": 2.981,
      "text": "Ce scarabée monumental est\nsculpté dans la diorite."
    },
    {
      "startSeconds": 3.481,
      "endSeconds": 5.142,
      "text": "Il représente probablement\nKhépri,"
    },
    {
      "startSeconds": 5.742,
      "endSeconds": 8.563,
      "text": "une forme du dieu solaire\nassociée au soleil levant."
    },
    {
      "startSeconds": 9.023,
      "endSeconds": 12.585,
      "text": "Dans les croyances de\nl’Égypte ancienne, le scarabée"
    },
    {
      "startSeconds": 12.645,
      "endSeconds": 15.626,
      "text": "évoquait la naissance et le\nrenouvellement."
    },
    {
      "startSeconds": 16.186,
      "endSeconds": 19.487,
      "text": "Observez son corps arrondi,\nses pattes et la base sur"
    },
    {
      "startSeconds": 19.487,
      "endSeconds": 22.589,
      "text": "laquelle il repose. Le\nsculpteur a transformé un petit"
    },
    {
      "startSeconds": 22.589,
      "endSeconds": 24.729,
      "text": "insecte en une présence\nmonumentale."
    },
    {
      "startSeconds": 25.23,
      "endSeconds": 28.691,
      "text": "L’œuvre nous invite à découvrir\nle lien entre le monde"
    },
    {
      "startSeconds": 28.971,
      "endSeconds": 31.392,
      "text": "naturel et les images des\ndieux."
    }
  ],
