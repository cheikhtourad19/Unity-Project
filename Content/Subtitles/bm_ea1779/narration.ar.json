  "segments": [
    {
      "startSeconds": 0.1,
      "endSeconds": 3.441,
      "text": "يمثل هذا التمثال الإله آمون\nفي هيئة كبش مستلقٍ."
    },
    {
      "startSeconds": 4.181,
      "endSeconds": 8.623,
      "text": "وبين ساقيه الأماميتين يقف\nتمثال صغير للملك تهارقا، في"
    },
    {
      "startSeconds": 8.623,
      "endSeconds": 9.423,
      "text": "حمايته."
    },
    {
      "startSeconds": 9.843,
      "endSeconds": 13.324,
      "text": "جاءت القطعة من معبد آمون في\nكاوا، في السودان الحالي."
    },
    {
      "startSeconds": 13.964,
      "endSeconds": 17.865,
      "text": "تأمل الفرق في الحجم بين\nالحيوان الكبير والملك، ثم انظر"
    },
    {
      "startSeconds": 17.865,
      "endSeconds": 19.126,
      "text": "إلى النقوش على القاعدة."
    },
    {
      "startSeconds": 19.786,
      "endSeconds": 23.727,
      "text": "يعبر هذا التكوين عن العلاقة\nبين السلطة الملكية والحماية"
    },
    {
      "startSeconds": 23.747,
      "endSeconds": 26.668,
      "text": "الإلهية، في تاريخ النوبة\nومصر."
    }
  ],
