  "segments": [
    {
      "startSeconds": 0.06,
      "endSeconds": 4.663,
      "text": "This statue represents the\ngod Amun as a reclining ram."
    },
    {
      "startSeconds": 5.563,
      "endSeconds": 9.185,
      "text": "Between its front legs\nstands a small figure of King"
    },
    {
      "startSeconds": 9.185,
      "endSeconds": 9.985,
      "text": "Taharqa,"
    },
    {
      "startSeconds": 10.446,
      "endSeconds": 11.566,
      "text": "sheltered by the god."
    },
    {
      "startSeconds": 12.427,
      "endSeconds": 16.009,
      "text": "The work comes from the\ntemple of Amun at Kawa,"
    },
    {
      "startSeconds": 16.649,
      "endSeconds": 17.99,
      "text": "in present-day Sudan."
    },
    {
      "startSeconds": 18.811,
      "endSeconds": 21.212,
      "text": "Notice the contrast between\nthe large animal"
    },
    {
      "startSeconds": 21.832,
      "endSeconds": 22.632,
      "text": "and the king,"
    },
    {
      "startSeconds": 24.214,
      "endSeconds": 27.195,
      "text": "then look at the\ninscriptions on the base."
    },
    {
      "startSeconds": 28.816,
      "endSeconds": 29.917,
      "text": "This composition"
    },
    {
      "startSeconds": 30.557,
      "endSeconds": 32.478,
      "text": "expresses a connection"
    },
    {
      "startSeconds": 33.339,
      "endSeconds": 34.899,
      "text": "between royal power"
    },
    {
      "startSeconds": 35.94,
      "endSeconds": 37.541,
      "text": "and divine protection"
    },
    {
      "startSeconds": 38.562,
      "endSeconds": 39.422,
      "text": "in the history"
    },
    {
      "startSeconds": 40.102,
      "endSeconds": 40.902,
      "text": "of Nubia"
    },
    {
      "startSeconds": 41.623,
      "endSeconds": 42.484,
      "text": "and Egypt."
    }
  ],
