  "segments": [
    {
      "startSeconds": 0.08,
      "endSeconds": 0.961,
      "text": "Cette statue"
    },
    {
      "startSeconds": 1.581,
      "endSeconds": 4.683,
      "text": "représente le dieu Amon sous\nla forme d’un bélier"
    },
    {
      "startSeconds": 4.683,
      "endSeconds": 5.483,
      "text": "couché."
    },
    {
      "startSeconds": 5.864,
      "endSeconds": 9.127,
      "text": "Entre ses pattes avant se\ntrouve une petite figure du"
    },
    {
      "startSeconds": 9.127,
      "endSeconds": 12.049,
      "text": "roi Taharqa, placée sous sa\nprotection."
    },
    {
      "startSeconds": 12.529,
      "endSeconds": 16.032,
      "text": "L’œuvre provient du temple\nd’Amon à Kawa, dans l’actuel"
    },
    {
      "startSeconds": 16.032,
      "endSeconds": 20.295,
      "text": "Soudan. Observez le contraste\nentre le grand animal et"
    },
    {
      "startSeconds": 20.295,
      "endSeconds": 23.497,
      "text": "le souverain, puis les\ninscriptions sur la base."
    },
    {
      "startSeconds": 24.558,
      "endSeconds": 27.38,
      "text": "Cette composition exprime\nune relation entre le pouvoir"
    },
    {
      "startSeconds": 27.4,
      "endSeconds": 30.522,
      "text": "royal et la protection\ndivine, dans l’histoire de la"
    },
    {
      "startSeconds": 30.522,
      "endSeconds": 31.783,
      "text": "Nubie et de l’Égypte."
    }
  ],
