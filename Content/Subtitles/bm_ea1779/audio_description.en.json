    {
      "startSeconds": 0.08,
      "endSeconds": 3.564,
      "text": "A large ram lies on a\nrectangular base."
    },
    {
      "startSeconds": 4.565,
      "endSeconds": 7.267,
      "text": "Its legs are folded beneath\nits body"
    },
    {
      "startSeconds": 8.128,
      "endSeconds": 9.69,
      "text": "and its head is raised."
    },
    {
      "startSeconds": 10.771,
      "endSeconds": 14.575,
      "text": "A small human figure stands\nbetween the front legs."
    },
    {
      "startSeconds": 15.696,
      "endSeconds": 18.239,
      "text": "It appears tiny beside the\nanimal."
    },
    {
      "startSeconds": 19.36,
      "endSeconds": 23.404,
      "text": "Rows of carved signs run\nalong the sides of the base."
    }
  ],
