  "segments": [
    {
      "startSeconds": 0.08,
      "endSeconds": 3.301,
      "text": "Un grand bélier est couché\nsur une base rectangulaire."
    },
    {
      "startSeconds": 3.742,
      "endSeconds": 7.383,
      "text": "Ses pattes sont repliées\nsous son corps et sa tête est"
    },
    {
      "startSeconds": 7.403,
      "endSeconds": 8.203,
      "text": "relevée."
    },
    {
      "startSeconds": 8.664,
      "endSeconds": 11.966,
      "text": "Une petite figure humaine se\ntient entre les pattes"
    },
    {
      "startSeconds": 12.046,
      "endSeconds": 15.287,
      "text": "avant. Elle paraît minuscule\nface à l’animal."
    },
    {
      "startSeconds": 15.907,
      "endSeconds": 19.389,
      "text": "Des rangées de signes gravés\nparcourent les côtés de la"
    },
    {
      "startSeconds": 19.389,
      "endSeconds": 19.889,
      "text": "base."
    }
  ],
