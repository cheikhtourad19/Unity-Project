  "segments": [
    {
      "startSeconds": 0.08,
      "endSeconds": 2.02,
      "text": "This reclining lion,"
    },
    {
      "startSeconds": 3.42,
      "endSeconds": 5.961,
      "text": "carved from red granite,"
    },
    {
      "startSeconds": 7.041,
      "endSeconds": 12.441,
      "text": "belongs to the pair known as\nthe Prudhoe Lions."
    },
    {
      "startSeconds": 14.302,
      "endSeconds": 17.922,
      "text": "It is associated with the\nreign"
    },
    {
      "startSeconds": 18.542,
      "endSeconds": 20.662,
      "text": "of Amenhotep"
    },
    {
      "startSeconds": 21.283,
      "endSeconds": 22.283,
      "text": "the Third."
    },
    {
      "startSeconds": 24.063,
      "endSeconds": 25.623,
      "text": "Its long body"
    },
    {
      "startSeconds": 26.603,
      "endSeconds": 27.443,
      "text": "rests"
    },
    {
      "startSeconds": 28.104,
      "endSeconds": 30.664,
      "text": "on an inscribed"
    },
    {
      "startSeconds": 31.404,
      "endSeconds": 32.424,
      "text": "pedestal."
    },
    {
      "startSeconds": 34.184,
      "endSeconds": 35.324,
      "text": "The texts"
    },
    {
      "startSeconds": 35.924,
      "endSeconds": 37.085,
      "text": "refer to"
    },
    {
      "startSeconds": 37.665,
      "endSeconds": 39.705,
      "text": "several rulers"
    },
    {
      "startSeconds": 40.905,
      "endSeconds": 42.005,
      "text": "and reveal"
    },
    {
      "startSeconds": 42.605,
      "endSeconds": 45.646,
      "text": "the sculpture’s long\nhistory."
    },
    {
      "startSeconds": 47.386,
      "endSeconds": 48.546,
      "text": "Look at the head,"
    },
    {
      "startSeconds": 50.046,
      "endSeconds": 51.106,
      "text": "the paws"
    },
    {
      "startSeconds": 52.346,
      "endSeconds": 54.967,
      "text": "and the carved signs."
    },
    {
      "startSeconds": 56.547,
      "endSeconds": 59.087,
      "text": "The image of a lion"
    },
    {
      "startSeconds": 60.307,
      "endSeconds": 63.428,
      "text": "expressed royal strength"
    },
    {
      "startSeconds": 64.188,
      "endSeconds": 69.528,
      "text": "while giving close attention\nto the animal’s"
    },
    {
      "startSeconds": 69.609,
      "endSeconds": 70.169,
      "text": "body."
    }
  ],
