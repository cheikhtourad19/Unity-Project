  "segments": [
    {
      "startSeconds": 0.06,
      "endSeconds": 2.622,
      "text": "Ce lion couché, sculpté dans\nle granite rouge,"
    },
    {
      "startSeconds": 2.903,
      "endSeconds": 5.525,
      "text": "appartient à la paire\nappelée les lions de Prudhoe."
    },
    {
      "startSeconds": 6.005,
      "endSeconds": 8.407,
      "text": "Il est associé au règne\nd’Amenhotep trois."
    },
    {
      "startSeconds": 8.688,
      "endSeconds": 11.53,
      "text": "Son corps allongé repose sur\nun socle portant des"
    },
    {
      "startSeconds": 11.53,
      "endSeconds": 15.233,
      "text": "inscriptions. Ces textes\névoquent plusieurs souverains"
    },
    {
      "startSeconds": 15.534,
      "endSeconds": 18.136,
      "text": "et témoignent de la longue\nhistoire de la sculpture."
    },
    {
      "startSeconds": 18.556,
      "endSeconds": 21.459,
      "text": "Observez la tête, les pattes\net les signes gravés."
    },
    {
      "startSeconds": 21.839,
      "endSeconds": 24.782,
      "text": "L’image du lion permettait\nd’exprimer la force royale,"
    },
    {
      "startSeconds": 24.782,
      "endSeconds": 27.104,
      "text": "tout en accordant une grande\nattention au corps de"
    },
    {
      "startSeconds": 27.104,
      "endSeconds": 27.684,
      "text": "l’animal."
    }
  ],
