  "segments": [
    {
      "startSeconds": 0.02,
      "endSeconds": 4.583,
      "text": "ينتمي هذا الأسد المستلقي،\nالمنحوت من الجرانيت الأحمر،"
    },
    {
      "startSeconds": 5.223,
      "endSeconds": 7.884,
      "text": "إلى الزوج المعروف باسم أسدي\nبرودهو."
    },
    {
      "startSeconds": 8.805,
      "endSeconds": 14.208,
      "text": "وهو مرتبط بعهد أمنحتب\nالثالث. يستند جسمه الممتد إلى"
    },
    {
      "startSeconds": 14.248,
      "endSeconds": 15.989,
      "text": "قاعدة تحمل نقوشاً."
    },
    {
      "startSeconds": 16.609,
      "endSeconds": 22.052,
      "text": "تشير النصوص إلى عدة حكام وتشهد\nعلى تاريخ التمثال الطويل."
    },
    {
      "startSeconds": 22.813,
      "endSeconds": 26.435,
      "text": "تأمل الرأس والكفوف والعلامات\nالمنقوشة."
    },
    {
      "startSeconds": 27.435,
      "endSeconds": 32.858,
      "text": "كانت صورة الأسد تعبر عن\nالقوة الملكية، مع اهتمام دقيق"
    },
    {
      "startSeconds": 32.978,
      "endSeconds": 34.079,
      "text": "بجسم الحيوان."
    }
  ],
