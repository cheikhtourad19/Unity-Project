  "segments": [
    {
      "startSeconds": 0.06,
      "endSeconds": 2.603,
      "text": "Un lion de pierre est couché\nsur un socle."
    },
    {
      "startSeconds": 3.024,
      "endSeconds": 5.767,
      "text": "Son corps allongé se termine\npar une tête modelée et des"
    },
    {
      "startSeconds": 5.767,
      "endSeconds": 9.051,
      "text": "pattes sculptées. Le granite\nrouge donne à l’ensemble"
    },
    {
      "startSeconds": 9.071,
      "endSeconds": 12.355,
      "text": "une teinte chaude. Des\ninscriptions occupent la poitrine"
    },
    {
      "startSeconds": 12.376,
      "endSeconds": 15.339,
      "text": "et plusieurs surfaces du\nsocle. Les formes du corps sont"
    },
    {
      "startSeconds": 15.359,
      "endSeconds": 17.842,
      "text": "arrondies, tandis que la\nbase présente des lignes"
    },
    {
      "startSeconds": 17.842,
      "endSeconds": 18.483,
      "text": "droites."
    }
  ],
