    {
      "startSeconds": 0.08,
      "endSeconds": 4.665,
      "text": "تحتفظ المنحوتة برأس بشري\nوالجزء العلوي من الجذع."
    },
    {
      "startSeconds": 5.386,
      "endSeconds": 9.69,
      "text": "يحيط بالوجه غطاء رأس مخطط\nيمتد على الكتفين."
    },
    {
      "startSeconds": 10.391,
      "endSeconds": 14.535,
      "text": "تجعل الأجزاء المفقودة حدود\nالجذع غير منتظمة."
    },
    {
      "startSeconds": 15.256,
      "endSeconds": 17.878,
      "text": "وتظهر في الحجر تدرجات لونية."
    },
    {
      "startSeconds": 18.539,
      "endSeconds": 23.284,
      "text": "تتجه الهيئة إلى الأمام، مما\nيمنح الوجه حضوراً بارزاً."
    }
  ],
