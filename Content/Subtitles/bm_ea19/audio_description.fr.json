  "segments": [
    {
      "startSeconds": 0.08,
      "endSeconds": 0.88,
      "text": "La sculpture"
    },
    {
      "startSeconds": 1.36,
      "endSeconds": 4.021,
      "text": "conserve une tête et le haut\nd’un buste humain."
    },
    {
      "startSeconds": 4.661,
      "endSeconds": 7.402,
      "text": "Le visage est encadré par\nune coiffe rayée qui descend"
    },
    {
      "startSeconds": 7.402,
      "endSeconds": 10.543,
      "text": "sur les épaules. Les parties\nmanquantes rendent le"
    },
    {
      "startSeconds": 10.543,
      "endSeconds": 13.864,
      "text": "contour du torse irrégulier.\nLa pierre présente des"
    },
    {
      "startSeconds": 13.864,
      "endSeconds": 15.024,
      "text": "variations de teinte."
    },
    {
      "startSeconds": 15.804,
      "endSeconds": 19.345,
      "text": "La figure est tournée vers\nl’avant, donnant une forte"
    },
    {
      "startSeconds": 19.345,
      "endSeconds": 20.406,
      "text": "présence au visage."
    }
  ],
