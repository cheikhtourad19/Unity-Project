  "segments": [
    {
      "startSeconds": 0.08,
      "endSeconds": 3.382,
      "text": "أمامك الجزء العلوي من تمثال\nضخم لرمسيس الثاني."
    },
    {
      "startSeconds": 3.802,
      "endSeconds": 6.663,
      "text": "جاء من الرامسيوم، معبده\nالجنائزي في طيبة."
    },
    {
      "startSeconds": 7.163,
      "endSeconds": 10.665,
      "text": "يرتدي الملك النمس، وهو غطاء\nالرأس المخطط الذي يرتديه"
    },
    {
      "startSeconds": 10.665,
      "endSeconds": 14.647,
      "text": "الفراعنة. تأمل الوجه\nوالكتفين وتدرجات لون الحجر."
    },
    {
      "startSeconds": 15.247,
      "endSeconds": 18.869,
      "text": "ورغم أن التمثال غير مكتمل،\nفإنه يحتفظ بحضور قوي."
    },
    {
      "startSeconds": 19.369,
      "endSeconds": 23.291,
      "text": "يبين كيف كانت الآثار تجسد\nسلطة الحاكم وتربط صورته"
    },
    {
      "startSeconds": 23.291,
      "endSeconds": 24.532,
      "text": "بالأماكن المقدسة."
    }
  ],
