  "segments": [
    {
      "startSeconds": 0.06,
      "endSeconds": 3.481,
      "text": "Here is the upper part of a\ncolossal statue of Ramesses"
    },
    {
      "startSeconds": 3.481,
      "endSeconds": 4.281,
      "text": "the Second."
    },
    {
      "startSeconds": 5.201,
      "endSeconds": 6.641,
      "text": "It comes from the Ramesseum,"
    },
    {
      "startSeconds": 7.242,
      "endSeconds": 9.242,
      "text": "his mortuary temple at\nThebes."
    },
    {
      "startSeconds": 10.262,
      "endSeconds": 13.763,
      "text": "The king wears the nemes,\nthe striped headdress of the"
    },
    {
      "startSeconds": 13.763,
      "endSeconds": 14.563,
      "text": "pharaohs."
    },
    {
      "startSeconds": 15.363,
      "endSeconds": 16.403,
      "text": "Look at the face,"
    },
    {
      "startSeconds": 17.024,
      "endSeconds": 20.524,
      "text": "the shoulders and the variations\nin the stone’s colour."
    },
    {
      "startSeconds": 21.885,
      "endSeconds": 23.365,
      "text": "Even as a fragment,"
    },
    {
      "startSeconds": 24.565,
      "endSeconds": 28.566,
      "text": "this sculpture retains a\npowerful presence."
    },
    {
      "startSeconds": 29.886,
      "endSeconds": 34.207,
      "text": "It shows how monuments could\nmake royal authority"
    },
    {
      "startSeconds": 35.247,
      "endSeconds": 36.047,
      "text": "visible"
    },
    {
      "startSeconds": 36.928,
      "endSeconds": 41.449,
      "text": "and connect the ruler’s\nimage with sacred spaces."
    }
  ],
