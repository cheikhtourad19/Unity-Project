    {
      "startSeconds": 0.08,
      "endSeconds": 3.844,
      "text": "The sculpture preserves a\nhuman head and upper torso."
    },
    {
      "startSeconds": 4.925,
      "endSeconds": 8.889,
      "text": "A striped headdress frames\nthe face and extends down"
    },
    {
      "startSeconds": 8.949,
      "endSeconds": 9.91,
      "text": "onto the shoulders."
    },
    {
      "startSeconds": 11.071,
      "endSeconds": 14.535,
      "text": "Missing parts make the\ntorso’s outline uneven."
    },
    {
      "startSeconds": 15.716,
      "endSeconds": 17.618,
      "text": "The stone varies in colour."
    },
    {
      "startSeconds": 18.539,
      "endSeconds": 19.98,
      "text": "The figure faces forward,"
    },
    {
      "startSeconds": 20.641,
      "endSeconds": 23.424,
      "text": "giving particular prominence\nto the face."
    }
  ],
