  "segments": [
    {
      "startSeconds": 0.08,
      "endSeconds": 2.561,
      "text": "Vous découvrez la partie\nsupérieure d’une statue"
    },
    {
      "startSeconds": 2.581,
      "endSeconds": 6.363,
      "text": "colossale de Ramsès deux.\nElle provient du Ramesseum,"
    },
    {
      "startSeconds": 6.863,
      "endSeconds": 8.563,
      "text": "son temple funéraire à\nThèbes."
    },
    {
      "startSeconds": 9.204,
      "endSeconds": 13.165,
      "text": "Le roi porte le némès, la\ncoiffe rayée des pharaons."
    },
    {
      "startSeconds": 13.746,
      "endSeconds": 16.947,
      "text": "Observez le visage, les\népaules et les variations de"
    },
    {
      "startSeconds": 16.947,
      "endSeconds": 17.927,
      "text": "couleur de la pierre."
    },
    {
      "startSeconds": 18.528,
      "endSeconds": 21.169,
      "text": "Même fragmentaire, cette\nsculpture conserve une forte"
    },
    {
      "startSeconds": 21.169,
      "endSeconds": 24.67,
      "text": "présence. Elle montre comment\nles monuments pouvaient"
    },
    {
      "startSeconds": 24.77,
      "endSeconds": 28.092,
      "text": "rendre visible le pouvoir du\nsouverain et associer son"
    },
    {
      "startSeconds": 28.092,
      "endSeconds": 30.052,
      "text": "image aux espaces sacrés."
    }
  ],
