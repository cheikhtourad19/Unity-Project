  "segments": [
    {
      "startSeconds": 0.06,
      "endSeconds": 4.523,
      "text": "هذا حجر رشيد، وهو جزء من\nلوحة من الجرانوديوريت."
    },
    {
      "startSeconds": 5.163,
      "endSeconds": 9.205,
      "text": "يحمل مرسوماً من عام مئة وستة\nوتسعين قبل الميلاد،"
    },
    {
      "startSeconds": 9.826,
      "endSeconds": 15.049,
      "text": "تكريماً لبطليموس الخامس. يظهر\nالمرسوم نفسه بثلاثة أنظمة"
    },
    {
      "startSeconds": 15.189,
      "endSeconds": 15.989,
      "text": "للكتابة:"
    },
    {
      "startSeconds": 16.61,
      "endSeconds": 20.312,
      "text": "الهيروغليفية والديموطيقية\nواليونانية."
    },
    {
      "startSeconds": 21.333,
      "endSeconds": 25.855,
      "text": "ساعدت المقارنة بينها الباحثين\nعلى فك رموز الهيروغليفية"
    },
    {
      "startSeconds": 25.935,
      "endSeconds": 26.735,
      "text": "المصرية."
    },
    {
      "startSeconds": 27.456,
      "endSeconds": 31.278,
      "text": "تأمل مجموعات العلامات\nالمختلفة على سطح الحجر."
    },
    {
      "startSeconds": 32.059,
      "endSeconds": 35.481,
      "text": "يذكرنا هذا الجزء كيف يمكن\nلنص مكتوب"
    },
    {
      "startSeconds": 36.081,
      "endSeconds": 38.743,
      "text": "أن يفتح نافذة على حضارة\nقديمة."
    }
  ],
