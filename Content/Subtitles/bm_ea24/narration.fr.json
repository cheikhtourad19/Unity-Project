  "segments": [
    {
      "startSeconds": 0.08,
      "endSeconds": 2.921,
      "text": "Voici la pierre de Rosette,\nun fragment de stèle en"
    },
    {
      "startSeconds": 2.921,
      "endSeconds": 5.883,
      "text": "granodiorite. Elle porte un\ndécret de l’année cent"
    },
    {
      "startSeconds": 5.883,
      "endSeconds": 8.824,
      "text": "quatre-vingt-seize avant\nnotre ère, en l’honneur de"
    },
    {
      "startSeconds": 8.824,
      "endSeconds": 12.126,
      "text": "Ptolémée le cinquième. Le\nmême décret apparaît en trois"
    },
    {
      "startSeconds": 12.126,
      "endSeconds": 15.928,
      "text": "écritures : les hiéroglyphes,\nle démotique et le grec."
    },
    {
      "startSeconds": 16.408,
      "endSeconds": 19.029,
      "text": "Leur comparaison a aidé à\ndéchiffrer les hiéroglyphes"
    },
    {
      "startSeconds": 19.029,
      "endSeconds": 22.491,
      "text": "égyptiens. Observez les\ndifférents groupes de signes sur"
    },
    {
      "startSeconds": 22.491,
      "endSeconds": 23.291,
      "text": "sa surface."
    },
    {
      "startSeconds": 23.852,
      "endSeconds": 26.653,
      "text": "Ce fragment rappelle comment\nun texte peut ouvrir une"
    },
    {
      "startSeconds": 26.653,
      "endSeconds": 28.234,
      "text": "fenêtre sur une\ncivilisation."
    }
  ],
