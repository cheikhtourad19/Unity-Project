  "segments": [
    {
      "startSeconds": 0.06,
      "endSeconds": 1.4,
      "text": "This is the Rosetta Stone,"
    },
    {
      "startSeconds": 1.981,
      "endSeconds": 4.241,
      "text": "a fragment of a granodiorite\nstele."
    },
    {
      "startSeconds": 5.142,
      "endSeconds": 9.103,
      "text": "It bears a decree from one\nhundred and ninety-six BCE,"
    },
    {
      "startSeconds": 9.683,
      "endSeconds": 11.584,
      "text": "honouring Ptolemy the Fifth."
    },
    {
      "startSeconds": 12.484,
      "endSeconds": 14.705,
      "text": "The same decree appears in\nthree scripts:"
    },
    {
      "startSeconds": 15.445,
      "endSeconds": 18.086,
      "text": "hieroglyphs, Demotic and\nGreek."
    },
    {
      "startSeconds": 18.926,
      "endSeconds": 22.387,
      "text": "Comparing them helped\nscholars decipher Egyptian"
    },
    {
      "startSeconds": 22.928,
      "endSeconds": 24.068,
      "text": "hieroglyphs."
    },
    {
      "startSeconds": 25.428,
      "endSeconds": 29.59,
      "text": "Look at the different groups\nof signs on its surface."
    },
    {
      "startSeconds": 30.93,
      "endSeconds": 36.152,
      "text": "This fragment shows how a\nwritten text can open a"
    },
    {
      "startSeconds": 36.232,
      "endSeconds": 39.173,
      "text": "window onto a civilisation."
    }
  ],
