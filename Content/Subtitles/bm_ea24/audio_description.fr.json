  "segments": [
    {
      "startSeconds": 0.08,
      "endSeconds": 3.263,
      "text": "La pierre se présente comme\nune plaque épaisse dressée"
    },
    {
      "startSeconds": 3.404,
      "endSeconds": 7.988,
      "text": "verticalement. Sa face\nprincipale porte des rangées"
    },
    {
      "startSeconds": 7.988,
      "endSeconds": 10.751,
      "text": "serrées de signes gravés. La\npartie supérieure est"
    },
    {
      "startSeconds": 10.751,
      "endSeconds": 13.214,
      "text": "brisée et son contour est\nirrégulier."
    },
    {
      "startSeconds": 13.514,
      "endSeconds": 16.077,
      "text": "Les inscriptions forment\nplusieurs ensembles superposés."
    },
    {
      "startSeconds": 16.397,
      "endSeconds": 18.399,
      "text": "Cette description donne les\ngrandes formes ;"
    },
    {
      "startSeconds": 18.7,
      "endSeconds": 21.222,
      "text": "elle ne lit ni ne traduit\nles signes."
    }
  ],
