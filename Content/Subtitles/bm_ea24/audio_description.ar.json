  "segments": [
    {
      "startSeconds": 0.06,
      "endSeconds": 3.341,
      "text": "يبدو الحجر كلوح سميك قائم\nعمودياً."
    },
    {
      "startSeconds": 4.141,
      "endSeconds": 8.863,
      "text": "يحمل وجهه الرئيسي صفوفاً\nمتقاربة من علامات منقوشة."
    },
    {
      "startSeconds": 9.643,
      "endSeconds": 13.084,
      "text": "الجزء العلوي مكسور وحدوده\nغير منتظمة."
    },
    {
      "startSeconds": 13.844,
      "endSeconds": 17.485,
      "text": "تشكل النقوش مجموعات مرتبة\nفوق بعضها."
    },
    {
      "startSeconds": 18.186,
      "endSeconds": 23.267,
      "text": "تصف هذه الكلمات الأشكال\nالرئيسية، ولا تقرأ العلامات ولا"
    },
    {
      "startSeconds": 23.267,
      "endSeconds": 24.127,
      "text": "تترجمها."
    }
  ],
