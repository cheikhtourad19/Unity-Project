  "segments": [
    {
      "startSeconds": 0.06,
      "endSeconds": 3.242,
      "text": "The stone is a thick slab\nstanding upright."
    },
    {
      "startSeconds": 4.183,
      "endSeconds": 7.865,
      "text": "Its main face carries\ntightly spaced rows of carved"
    },
    {
      "startSeconds": 7.905,
      "endSeconds": 8.705,
      "text": "signs."
    },
    {
      "startSeconds": 9.386,
      "endSeconds": 12.709,
      "text": "The upper part is broken and\nhas an uneven outline."
    },
    {
      "startSeconds": 13.689,
      "endSeconds": 16.971,
      "text": "The inscriptions form several\ngroups arranged one above"
    },
    {
      "startSeconds": 16.971,
      "endSeconds": 17.771,
      "text": "another."
    },
    {
      "startSeconds": 18.392,
      "endSeconds": 20.874,
      "text": "This description outlines\nthe main shapes;"
    },
    {
      "startSeconds": 22.555,
      "endSeconds": 25.998,
      "text": "it does not read or\ntranslate the signs."
    }
  ],
