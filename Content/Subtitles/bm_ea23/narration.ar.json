  "segments": [
    {
      "startSeconds": 0.02,
      "endSeconds": 3.221,
      "text": "كان هذا التابوت الجرانيتي\nيخص حابمن،"
    },
    {
      "startSeconds": 3.841,
      "endSeconds": 6.742,
      "text": "وهو من كبار الموظفين في مصر\nالقديمة."
    },
    {
      "startSeconds": 7.402,
      "endSeconds": 11.843,
      "text": "تحمل جدرانه نصوصاً وصوراً\nلآلهة جنائزية."
    },
    {
      "startSeconds": 12.783,
      "endSeconds": 16.264,
      "text": "وفي الداخل، تظهر الإلهة نوت\nفي قاع الحوض."
    },
    {
      "startSeconds": 16.924,
      "endSeconds": 22.105,
      "text": "تأمل النقوش البارزة وكيف\nتحيط بالمكان المخصص للمتوفى."
    },
    {
      "startSeconds": 22.125,
      "endSeconds": 27.606,
      "text": "أُعيد استخدام التابوت لاحقاً\nللاغتسال الطقسي في مسجد"
    },
    {
      "startSeconds": 27.606,
      "endSeconds": 29.086,
      "text": "ابن طولون بالقاهرة."
    },
    {
      "startSeconds": 29.967,
      "endSeconds": 35.008,
      "text": "وهكذا تحتفظ القطعة بآثار\nاستخدامات متعددة عبر الزمن."
    }
  ],
