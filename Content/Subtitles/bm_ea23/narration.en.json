  "segments": [
    {
      "startSeconds": 0.08,
      "endSeconds": 2.56,
      "text": "This granite sarcophagus"
    },
    {
      "startSeconds": 3.6,
      "endSeconds": 5.28,
      "text": "belonged to Hapmen,"
    },
    {
      "startSeconds": 6.861,
      "endSeconds": 8.421,
      "text": "a high official"
    },
    {
      "startSeconds": 9.201,
      "endSeconds": 11.161,
      "text": "in ancient Egypt."
    },
    {
      "startSeconds": 12.561,
      "endSeconds": 15.141,
      "text": "Its walls carry texts"
    },
    {
      "startSeconds": 15.721,
      "endSeconds": 16.821,
      "text": "and figures"
    },
    {
      "startSeconds": 17.401,
      "endSeconds": 18.921,
      "text": "of funerary"
    },
    {
      "startSeconds": 19.722,
      "endSeconds": 20.862,
      "text": "deities."
    },
    {
      "startSeconds": 22.342,
      "endSeconds": 23.482,
      "text": "Inside,"
    },
    {
      "startSeconds": 24.402,
      "endSeconds": 25.542,
      "text": "the goddess"
    },
    {
      "startSeconds": 26.142,
      "endSeconds": 26.942,
      "text": "Nut"
    },
    {
      "startSeconds": 27.422,
      "endSeconds": 31.923,
      "text": "appears on the bottom of the\nchest."
    },
    {
      "startSeconds": 33.323,
      "endSeconds": 35.763,
      "text": "Notice the reliefs"
    },
    {
      "startSeconds": 36.783,
      "endSeconds": 39.903,
      "text": "and how they surround the\nspace"
    },
    {
      "startSeconds": 40.683,
      "endSeconds": 44.384,
      "text": "intended for the deceased."
    },
    {
      "startSeconds": 45.804,
      "endSeconds": 47.364,
      "text": "The sarcophagus"
    },
    {
      "startSeconds": 48.064,
      "endSeconds": 50.324,
      "text": "was later reused"
    },
    {
      "startSeconds": 50.984,
      "endSeconds": 53.604,
      "text": "for ritual washing"
    },
    {
      "startSeconds": 54.344,
      "endSeconds": 55.544,
      "text": "in the Ibn"
    },
    {
      "startSeconds": 56.224,
      "endSeconds": 57.165,
      "text": "Tulun"
    },
    {
      "startSeconds": 57.745,
      "endSeconds": 58.625,
      "text": "Mosque"
    },
    {
      "startSeconds": 59.585,
      "endSeconds": 60.665,
      "text": "in Cairo."
    },
    {
      "startSeconds": 62.325,
      "endSeconds": 67.525,
      "text": "It therefore preserves\ntraces of different"
    },
    {
      "startSeconds": 67.945,
      "endSeconds": 68.745,
      "text": "uses"
    },
    {
      "startSeconds": 69.346,
      "endSeconds": 73.346,
      "text": "across its long history."
    }
  ],
