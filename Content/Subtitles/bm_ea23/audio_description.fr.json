  "segments": [
    {
      "startSeconds": 0.06,
      "endSeconds": 3.204,
      "text": "Une grande cuve de pierre\nforme un espace creux, ouvert"
    },
    {
      "startSeconds": 3.204,
      "endSeconds": 6.728,
      "text": "vers le haut. Ses parois\népaisses sont couvertes de"
    },
    {
      "startSeconds": 6.768,
      "endSeconds": 8.57,
      "text": "signes et de figures en\nrelief."
    },
    {
      "startSeconds": 9.191,
      "endSeconds": 11.013,
      "text": "D’autres figures décorent\nl’intérieur."
    },
    {
      "startSeconds": 11.493,
      "endSeconds": 15.158,
      "text": "Une silhouette féminine,\ncelle de Nout, s’étend au fond"
    },
    {
      "startSeconds": 15.158,
      "endSeconds": 18.642,
      "text": "de la cuve. L’ensemble\nprésente la forme allongée d’un"
    },
    {
      "startSeconds": 18.642,
      "endSeconds": 20.724,
      "text": "contenant destiné à un corps\nhumain."
    }
  ],
