      "startSeconds": 0.04,
      "endSeconds": 3.703,
      "text": "يشكل حوض حجري كبير فراغاً\nمفتوحاً من الأعلى."
    },
    {
      "startSeconds": 4.564,
      "endSeconds": 8.067,
      "text": "تغطي العلامات والرسوم\nالبارزة جدرانه السميكة."
    },
    {
      "startSeconds": 8.748,
      "endSeconds": 14.312,
      "text": "وتزين صور أخرى الداخل. تمتد\nهيئة أنثوية، هي نوت، في قاع"
    },
    {
      "startSeconds": 14.312,
      "endSeconds": 15.112,
      "text": "الحوض."
    },
    {
      "startSeconds": 15.433,
      "endSeconds": 19.537,
      "text": "ويأخذ التكوين شكل وعاء ممدود\nمخصص لجسم إنسان."
    }
  ],
