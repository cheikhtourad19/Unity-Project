  "segments": [
    {
      "startSeconds": 0.04,
      "endSeconds": 3.461,
      "text": "Ce sarcophage de granite\nappartenait à Hapmen, un haut"
    },
    {
      "startSeconds": 3.461,
      "endSeconds": 4.962,
      "text": "fonctionnaire de l’Égypte\nancienne."
    },
    {
      "startSeconds": 5.442,
      "endSeconds": 8.763,
      "text": "Ses parois portent des\ntextes et des figures de"
    },
    {
      "startSeconds": 8.763,
      "endSeconds": 11.864,
      "text": "divinités funéraires. À\nl’intérieur, la déesse Nout est"
    },
    {
      "startSeconds": 12.004,
      "endSeconds": 15.245,
      "text": "représentée au fond de la\ncuve. Observez les reliefs et"
    },
    {
      "startSeconds": 15.245,
      "endSeconds": 17.906,
      "text": "la manière dont ils\nentourent l’espace destiné au"
    },
    {
      "startSeconds": 17.906,
      "endSeconds": 21.788,
      "text": "défunt. Le sarcophage fut\nplus tard réutilisé pour des"
    },
    {
      "startSeconds": 21.788,
      "endSeconds": 24.928,
      "text": "ablutions dans la mosquée\nIbn Touloun, au Caire."
    },
    {
      "startSeconds": 25.129,
      "endSeconds": 27.97,
      "text": "Cette œuvre conserve ainsi\nles traces de plusieurs"
    },
    {
      "startSeconds": 27.97,
      "endSeconds": 29.21,
      "text": "usages au fil du temps."
    }
  ],
