    {
      "startSeconds": 0.08,
      "endSeconds": 2.24,
      "text": "A large stone chest"
    },
    {
      "startSeconds": 3.14,
      "endSeconds": 5.441,
      "text": "forms a hollow space"
    },
    {
      "startSeconds": 6.901,
      "endSeconds": 8.901,
      "text": "open at the top."
    },
    {
      "startSeconds": 10.601,
      "endSeconds": 12.441,
      "text": "Its thick walls"
    },
    {
      "startSeconds": 13.101,
      "endSeconds": 15.182,
      "text": "are covered with signs"
    },
    {
      "startSeconds": 16.062,
      "endSeconds": 17.222,
      "text": "and figures"
    },
    {
      "startSeconds": 18.402,
      "endSeconds": 19.462,
      "text": "in relief."
    },
    {
      "startSeconds": 21.102,
      "endSeconds": 26.243,
      "text": "More figures decorate the\ninterior."
    },
    {
      "startSeconds": 27.923,
      "endSeconds": 30.303,
      "text": "A female figure,"
    },
    {
      "startSeconds": 32.004,
      "endSeconds": 32.804,
      "text": "Nut,"
    },
    {
      "startSeconds": 33.744,
      "endSeconds": 38.704,
      "text": "extends across the bottom of\nthe"
    },
    {
      "startSeconds": 38.944,
      "endSeconds": 39.784,
      "text": "chest."
    },
    {
      "startSeconds": 41.365,
      "endSeconds": 43.265,
      "text": "The overall form"
    },
    {
      "startSeconds": 44.225,
      "endSeconds": 47.065,
      "text": "is an elongated container"
    },
    {
      "startSeconds": 48.125,
      "endSeconds": 51.686,
      "text": "intended for a human"
    },
    {
      "startSeconds": 52.286,
      "endSeconds": 52.866,
      "text": "body."
    }
