{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://heritagexr.local/schemas/quiz.v1.json",
  "title": "HeritageXR quiz game contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "kind",
    "contentVersion",
    "publicationStatus",
    "questions"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]+$"
    },
    "kind": {
      "const": "quiz"
    },
    "contentVersion": {
      "type": "integer",
      "minimum": 1
    },
    "publicationStatus": {
      "enum": [
        "draft",
        "ready",
        "published",
        "archived"
      ]
    },
    "questions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/question"
      }
    }
  },
  "$defs": {
    "localized": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fr",
        "ar",
        "en"
      ],
      "properties": {
        "fr": {
          "type": "string",
          "minLength": 1
        },
        "ar": {
          "type": "string",
          "minLength": 1
        },
        "en": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "option": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "text"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]+$"
        },
        "text": {
          "$ref": "#/$defs/localized"
        }
      }
    },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "prompt",
        "options",
        "correctOptionId",
        "explanation",
        "sourceScriptPath",
        "sources"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]+$"
        },
        "prompt": {
          "$ref": "#/$defs/localized"
        },
        "options": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "$ref": "#/$defs/option"
          }
        },
        "correctOptionId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]+$"
        },
        "explanation": {
          "$ref": "#/$defs/localized"
        },
        "sourceScriptPath": {
          "type": "string",
          "minLength": 1
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "$comment": "Quiz ids and question ids unique globally; option ids unique per question; correctOptionId must reference exactly one option. Increasing contentVersion invalidates prior revision progress. Question count is extensible."
}
