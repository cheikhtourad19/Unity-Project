        text: 'his mortuary temple at

          Thebes.'
      - startSeconds: 10.262
        endSeconds: 13.763
        text: 'The king wears the nemes,

          the striped headdress of the'
      - startSeconds: 13.763
        endSeconds: 14.563
        text: pharaohs.
      - startSeconds: 15.363
        endSeconds: 16.403
        text: Look at the face,
      - startSeconds: 17.024
