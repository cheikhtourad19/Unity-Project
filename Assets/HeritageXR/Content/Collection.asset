    audio:
    - id: bm_ea19.narration.fr
      language: fr
      kind: narration
      transcript: "Vous d\xE9couvrez la partie sup\xE9rieure d\u2019une statue colossale de Rams\xE8s deux. Elle provient du Ramesseum, son temple fun\xE9raire \xE0 Th\xE8bes. Le roi porte le n\xE9m\xE8s, la coiffe ray\xE9e des pharaons. Observez le visage, les \xE9paules et les variations de couleur de la pierre. M\xEAme fragmentaire, cette sculpture conserve une forte pr\xE9sence. Elle montre comment les monuments pouvaient rendre visible le pouvoir du souverain et associer son image aux espaces sacr\xE9s."
      voiceId: 6DEjyaHWnTHsvXM5Byys
      modelId: eleven_multilingual_v2
      clip: {fileID: 8300000, guid: 0dc159f7c023e443c93bf99a4ad12710, type: 3}
      subtitles:
      - startSeconds: 0.08
        endSeconds: 2.561
        text: "Vous d\xE9couvrez la partie\nsup\xE9rieure d\u2019une statue"
      - startSeconds: 2.581
        endSeconds: 6.363
        text: "colossale de Rams\xE8s deux.\nElle provient du Ramesseum,"
      - startSeconds: 6.863
        endSeconds: 8.563
        text: "son temple fun\xE9raire \xE0\nTh\xE8bes."
      - startSeconds: 9.204
        endSeconds: 13.165
        text: "Le roi porte le n\xE9m\xE8s, la\ncoiffe ray\xE9e des pharaons."
      - startSeconds: 13.746
        endSeconds: 16.947
        text: "Observez le visage, les\n\xE9paules et les variations de"
      - startSeconds: 16.947
        endSeconds: 17.927
        text: couleur de la pierre.
      - startSeconds: 18.528
        endSeconds: 21.169
        text: "M\xEAme fragmentaire, cette\nsculpture conserve une forte"
      - startSeconds: 21.169
        endSeconds: 24.67
        text: "pr\xE9sence. Elle montre comment\nles monuments pouvaient"
      - startSeconds: 24.77
        endSeconds: 28.092
        text: 'rendre visible le pouvoir du

          souverain et associer son'
      - startSeconds: 28.092
        endSeconds: 30.052
        text: "image aux espaces sacr\xE9s."
    - id: bm_ea19.audio_description.fr
      language: fr
      kind: audio_description
      transcript: "La sculpture conserve une t\xEAte et le haut d\u2019un buste humain. Le visage est encadr\xE9 par une coiffe ray\xE9e qui descend sur les \xE9paules. Les parties manquantes rendent le contour du torse irr\xE9gulier. La pierre pr\xE9sente des variations de teinte. La figure est tourn\xE9e vers l\u2019avant, donnant une forte pr\xE9sence au visage."
      voiceId: 6DEjyaHWnTHsvXM5Byys
      modelId: eleven_multilingual_v2
      clip: {fileID: 8300000, guid: 219b320a8c9c4432daf93b85ac1310ce, type: 3}
      subtitles:
