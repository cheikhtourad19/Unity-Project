        endSeconds: 0.88
        text: La sculpture
      - startSeconds: 1.36
        endSeconds: 4.021
        text: "conserve une t\xEAte et le haut\nd\u2019un buste humain."
      - startSeconds: 4.661
        endSeconds: 7.402
        text: "Le visage est encadr\xE9 par\nune coiffe ray\xE9e qui descend"
      - startSeconds: 7.402
        endSeconds: 10.543
        text: "sur les \xE9paules. Les parties\nmanquantes rendent le"
      - startSeconds: 10.543
        endSeconds: 13.864
        text: "contour du torse irr\xE9gulier.\nLa pierre pr\xE9sente des"
      - startSeconds: 13.864
