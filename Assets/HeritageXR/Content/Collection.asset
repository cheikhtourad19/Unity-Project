        text: The head
      - startSeconds: 17.742
        endSeconds: 20.262
        text: occupies one end.
      - startSeconds: 21.403
        endSeconds: 26.283
        text: 'Its legs are carved along

          the'
      - startSeconds: 26.423
        endSeconds: 27.423
        text: sides,
      - startSeconds: 28.303
        endSeconds: 30.684
        text: close to the base.
      - startSeconds: 32.444
        endSeconds: 36.264
        text: 'The overall form is compact:'
      - startSeconds: 37.725
        endSeconds: 39.345
        text: "the body\u2019s mass"
      - startSeconds: 39.985
        endSeconds: 44.905
        text: 'dominates the finer details

